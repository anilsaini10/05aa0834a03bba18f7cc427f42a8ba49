// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────
enum Role {
  ADMIN
  TEACHER
  PARENT
}

enum Platform {
  ANDROID
  IOS
  WEB
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AnnouncementAudience {
  ALL
  TEACHER
  PARENT
}

enum EventType {
  HOLIDAY
  EXAM
  MEETING
  ACTIVITY
  OTHER
}

enum ResultStatus {
  PENDING
  GRADED
  ABSENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HomeworkType {
  ASSIGNMENT
  PROJECT
  READING
  PRACTICE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleType {
  CLASS_PERIOD
  BREAK
}

// ── User ──────────────────────────────────────────────────────
model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?        @unique
  passwordHash  String
  role          Role
  schoolId      String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school           School         @relation(fields: [schoolId], references: [id])
  refreshTokens    RefreshToken[]
  deviceTokens     DeviceToken[]
  parentOfStudents      Student[]
  teacherProfile        Teacher?
  announcementsCreated  Announcement[]
  eventsCreated         Event[]
  examsCreated          Exam[]
  attendanceMarked      AttendanceRecord[]
  homeworkCreated       Homework[]
  classSchedulesCreated ClassSchedule[]
  leaveRequestsApplied  LeaveRequest[]    @relation("LeaveAppliedBy")
  leaveRequestsReviewed LeaveRequest[]    @relation("LeaveReviewedBy")
  teacherLeaveRequestsReviewed TeacherLeaveRequest[] @relation("TeacherLeaveReviewedBy")
  teacherAttendanceMarked      TeacherAttendanceRecord[]

  @@index([schoolId])
  @@map("users")
}

// ── School ────────────────────────────────────────────────────
model School {
  id        String    @id @default(uuid())
  name      String
  city      String?
  createdAt DateTime  @default(now())

  users         User[]
  classes       Class[]
  subjects      Subject[]
  students      Student[]
  teachers      Teacher[]
  announcements     Announcement[]
  events            Event[]
  exams             Exam[]
  attendanceRecords AttendanceRecord[]
  homework          Homework[]
  classSchedules    ClassSchedule[]
  leaveRequests     LeaveRequest[]
  teacherLeaveRequests TeacherLeaveRequest[]
  teacherAttendanceRecords TeacherAttendanceRecord[]
  staff             Staff[]

  @@map("schools")
}

// ── Announcement ──────────────────────────────────────────────
model Announcement {
  id            String               @id @default(uuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id])
  title         String
  message       String
  audience      AnnouncementAudience @default(ALL)
  eventDate     DateTime?
  publishAt     DateTime?
  expiresAt     DateTime?
  createdBy     String
  createdByUser User                 @relation(fields: [createdBy], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([schoolId])
  @@map("announcements")
}

// ── Event ─────────────────────────────────────────────────────
// Fixed-date school events — holidays, exam schedules, meetings, etc.
model Event {
  id            String               @id @default(uuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id])
  title         String
  description   String?
  eventType     EventType
  audience      AnnouncementAudience @default(ALL)
  startDate     DateTime
  endDate       DateTime
  createdBy     String
  createdByUser User                 @relation(fields: [createdBy], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([schoolId])
  @@index([startDate])
  @@map("events")
}

// ── Exam ──────────────────────────────────────────────────────
model Exam {
  id            String       @id @default(uuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  title         String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  createdBy     String
  createdByUser User         @relation(fields: [createdBy], references: [id])
  classes       ExamClass[]
  results       ExamResult[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([schoolId])
  @@map("exams")
}

// ── ExamClass ─────────────────────────────────────────────────
// Which classes this exam applies to, and the max marks for that class
// (e.g. Class 5 exam out of 50, Class 10 exam out of 100).
model ExamClass {
  examId   String
  classId  String
  maxMarks Float
  exam     Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  class    Class @relation(fields: [classId], references: [id])

  @@id([examId, classId])
  @@map("exam_classes")
}

// ── ExamResult ────────────────────────────────────────────────
// One row per student per exam — marks/grade/status. classId is a
// snapshot of the student's class at grading time (not re-derived),
// so it stays historically accurate even if the student later moves classes.
model ExamResult {
  id            String       @id @default(uuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id])
  classId       String
  class         Class        @relation(fields: [classId], references: [id])
  marksObtained Float?
  grade         String?
  remarks       String?
  status        ResultStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([examId, studentId])
  @@map("exam_results")
}

// ── AttendanceRecord ────────────────────────────────────────────
// One row per student per calendar day. classId/sectionId are a
// snapshot at marking time (mirrors ExamResult's approach).
model AttendanceRecord {
  id           String           @id @default(uuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  classId      String
  class        Class            @relation(fields: [classId], references: [id])
  sectionId    String
  section      Section          @relation(fields: [sectionId], references: [id])
  date         DateTime         @db.Date
  status       AttendanceStatus
  markedBy     String
  markedByUser User             @relation(fields: [markedBy], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([classId, date])
  @@map("attendance_records")
}

// ── Homework ────────────────────────────────────────────────────
// Assigned by the subject teacher (must teach this subject in this
// class, via TeacherSubject — not restricted to the Class Teacher).
model Homework {
  id            String       @id @default(uuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  classId       String
  class         Class        @relation(fields: [classId], references: [id])
  sectionId     String
  section       Section      @relation(fields: [sectionId], references: [id])
  subjectId     String
  subject       Subject      @relation(fields: [subjectId], references: [id])
  title         String
  description   String?
  type          HomeworkType @default(ASSIGNMENT)
  dueDate       DateTime
  createdBy     String
  createdByUser User         @relation(fields: [createdBy], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([schoolId])
  @@index([classId, sectionId, dueDate])
  @@map("homework")
}

// ── ClassSchedule ─────────────────────────────────────────────────
// One row = one period (or break) for a section, on a given day of
// the week. "School timing" and "teacher schedule" are NOT separate
// tables — both are just views/queries over this same table (derived,
// not stored, so there's nothing to keep in sync).
model ClassSchedule {
  id            String       @id @default(uuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  classId       String
  class         Class        @relation(fields: [classId], references: [id])
  sectionId     String
  section       Section      @relation(fields: [sectionId], references: [id])
  day           DayOfWeek
  type          ScheduleType
  periodNo      Int
  subjectId     String?
  subject       Subject?     @relation(fields: [subjectId], references: [id])
  teacherId     String?
  teacher       Teacher?     @relation(fields: [teacherId], references: [id])
  roomNo        String?
  title         String?
  startTime     String       // "HH:MM", 24-hour, no date component
  endTime       String       // "HH:MM", 24-hour, no date component
  createdBy     String
  createdByUser User         @relation(fields: [createdBy], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([sectionId, day, periodNo])
  @@index([schoolId])
  @@index([teacherId, day])
  @@index([roomNo, day])
  @@map("class_schedules")
}

// ── RefreshToken ───────────────────────────────────────────────
model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ── DeviceToken ────────────────────────────────────────────────
model DeviceToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  platform  Platform?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// ── Class ─────────────────────────────────────────────────────
model Class {
  id              String           @id @default(uuid())
  name            String
  numericLevel    Int
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id])
  sections        Section[]
  students        Student[]
  subjects          ClassSubject[]
  teacherSubjects   TeacherSubject[]
  examClasses       ExamClass[]
  examResults       ExamResult[]
  attendanceRecords AttendanceRecord[]
  homework          Homework[]
  classSchedules    ClassSchedule[]
  leaveRequests     LeaveRequest[]
  createdAt         DateTime           @default(now())

  @@unique([schoolId, name])
  @@map("classes")
}

// ── Section ───────────────────────────────────────────────────
model Section {
  id             String    @id @default(uuid())
  name           String
  classId        String
  class          Class     @relation(fields: [classId], references: [id])
  capacity       Int
  classTeacherId String?
  classTeacher   Teacher?  @relation(fields: [classTeacherId], references: [id])
  students       Student[]
  attendanceRecords AttendanceRecord[]
  homework       Homework[]
  classSchedules ClassSchedule[]
  leaveRequests  LeaveRequest[]

  @@unique([classId, name])
  @@map("sections")
}

// ── Subject ───────────────────────────────────────────────────
model Subject {
  id       String           @id @default(uuid())
  name     String
  schoolId String
  school   School           @relation(fields: [schoolId], references: [id])
  teachers TeacherSubject[]
  classes  ClassSubject[]
  homework Homework[]
  classSchedules ClassSchedule[]

  @@unique([schoolId, name])
  @@map("subjects")
}

// ── ClassSubject ──────────────────────────────────────────────
// Curriculum link: which subjects are taught in which class.
model ClassSubject {
  classId   String
  subjectId String
  class     Class   @relation(fields: [classId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([classId, subjectId])
  @@map("class_subjects")
}

// ── Student ───────────────────────────────────────────────────
model Student {
  id                   String   @id @default(uuid())
  admissionNo          String
  name                 String
  gender               Gender
  dateOfBirth          DateTime
  classId              String
  class                Class    @relation(fields: [classId], references: [id])
  sectionId            String
  section              Section  @relation(fields: [sectionId], references: [id])
  rollNo               Int
  parentUserId         String
  parentUser           User     @relation(fields: [parentUserId], references: [id])
  parentName           String
  parentPhone          String
  parentEmail          String
  bloodGroup           String?
  address              String?
  status               String   @default("ACTIVE")
  attendancePercentage Float    @default(100)
  schoolId             String
  school               School   @relation(fields: [schoolId], references: [id])
  examResults          ExamResult[]
  attendanceRecords    AttendanceRecord[]
  leaveRequests        LeaveRequest[]
  createdAt            DateTime @default(now())

  @@index([schoolId])
  @@map("students")
}

// ── Teacher ───────────────────────────────────────────────────
model Teacher {
  id                String           @id @default(uuid())
  employeeId        String
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id])
  gender            Gender
  joiningDate       DateTime
  salary            Float
  qualification     String           @default("")
  experienceYears   Int              @default(0)
  experienceMonths  Int              @default(0)
  // Subjects this teacher is generally qualified to teach — a plain name
  // list, not tied to any class. Actual class+subject scheduling
  // assignments still live in TeacherSubject (via assign-subject endpoint).
  subjectsTaught    String[]         @default([])
  status            String           @default("ACTIVE")
  performanceScore  Float            @default(0)
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id])
  subjects          TeacherSubject[]
  sectionsAsTeacher Section[]
  classSchedules    ClassSchedule[]
  leaveRequests     TeacherLeaveRequest[]
  attendanceRecords TeacherAttendanceRecord[]

  @@index([schoolId])
  @@map("teachers")
}

// ── TeacherSubject ────────────────────────────────────────────
// Which teacher teaches which subject, in which class.
model TeacherSubject {
  teacherId String
  subjectId String
  classId   String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  class     Class   @relation(fields: [classId], references: [id])

  @@id([teacherId, subjectId, classId])
  @@map("teacher_subjects")
}

// ── LeaveRequest ──────────────────────────────────────────────
// A parent applies for their child's leave; either the Class Teacher
// of the section or an Admin can approve/reject. Approval auto-marks
// AttendanceRecord as LEAVE for every date in [fromDate, toDate].
model LeaveRequest {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  classId        String
  class          Class        @relation(fields: [classId], references: [id])
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id])
  fromDate       DateTime     @db.Date
  toDate         DateTime     @db.Date
  reason         String
  status         LeaveStatus  @default(PENDING)
  appliedBy      String
  appliedByUser  User         @relation("LeaveAppliedBy", fields: [appliedBy], references: [id])
  reviewedBy     String?
  reviewedByUser User?        @relation("LeaveReviewedBy", fields: [reviewedBy], references: [id])
  reviewedAt     DateTime?
  reviewRemarks  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([sectionId, status])
  @@map("leave_requests")
}

// ── TeacherLeaveRequest ───────────────────────────────────────
// A teacher's own leave — separate from LeaveRequest (student leave)
// since there's no student/class/section context here, only Admin
// reviews it (no "class teacher of the teacher" concept), and there's
// no attendance record to auto-mark (staff attendance isn't tracked).
model TeacherLeaveRequest {
  id             String      @id @default(uuid())
  schoolId       String
  school         School      @relation(fields: [schoolId], references: [id])
  teacherId      String
  teacher        Teacher     @relation(fields: [teacherId], references: [id])
  fromDate       DateTime    @db.Date
  toDate         DateTime    @db.Date
  reason         String
  status         LeaveStatus @default(PENDING)
  reviewedBy     String?
  reviewedByUser User?       @relation("TeacherLeaveReviewedBy", fields: [reviewedBy], references: [id])
  reviewedAt     DateTime?
  reviewRemarks  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([schoolId])
  @@index([teacherId])
  @@map("teacher_leave_requests")
}

// ── TeacherAttendanceRecord ───────────────────────────────────
// Staff attendance — ADMIN-only (no "class teacher of the teacher"
// concept). One row per teacher per calendar day, same AttendanceStatus
// enum as student attendance so both share the same status vocabulary.
model TeacherAttendanceRecord {
  id           String           @id @default(uuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id])
  teacherId    String
  teacher      Teacher          @relation(fields: [teacherId], references: [id])
  date         DateTime         @db.Date
  status       AttendanceStatus
  markedBy     String
  markedByUser User             @relation(fields: [markedBy], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([teacherId, date])
  @@index([schoolId, date])
  @@map("teacher_attendance_records")
}

// ── Staff ─────────────────────────────────────────────────────
// Non-teaching staff (accountant, librarian, driver, peon, etc.) —
// a plain record managed by Admin, no login/User account (unlike
// Teacher). designation is free text since titles vary by school.
model Staff {
  id                String   @id @default(uuid())
  employeeId        String
  name              String
  email             String?
  phone             String
  gender            Gender
  designation       String
  salary            Float
  qualification     String   @default("")
  experienceYears   Int      @default(0)
  experienceMonths  Int      @default(0)
  joiningDate       DateTime
  status            String   @default("ACTIVE")
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([schoolId])
  @@map("staff")
}
