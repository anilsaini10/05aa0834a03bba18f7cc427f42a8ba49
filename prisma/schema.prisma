// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────
enum Role {
  ADMIN
  TEACHER
  PARENT
}

enum Platform {
  ANDROID
  IOS
  WEB
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AnnouncementAudience {
  ALL
  TEACHER
  PARENT
}

enum EventType {
  HOLIDAY
  EXAM
  MEETING
  ACTIVITY
  OTHER
}

enum ResultStatus {
  PENDING
  GRADED
  ABSENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum HomeworkType {
  ASSIGNMENT
  PROJECT
  READING
  PRACTICE
  OTHER
}

// ── User ──────────────────────────────────────────────────────
model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?        @unique
  passwordHash  String
  role          Role
  schoolId      String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school           School         @relation(fields: [schoolId], references: [id])
  refreshTokens    RefreshToken[]
  deviceTokens     DeviceToken[]
  parentOfStudents      Student[]
  teacherProfile        Teacher?
  announcementsCreated  Announcement[]
  eventsCreated         Event[]
  examsCreated          Exam[]
  attendanceMarked      AttendanceRecord[]
  homeworkCreated       Homework[]

  @@index([schoolId])
  @@map("users")
}

// ── School ────────────────────────────────────────────────────
model School {
  id        String    @id @default(uuid())
  name      String
  city      String?
  createdAt DateTime  @default(now())

  users         User[]
  classes       Class[]
  subjects      Subject[]
  students      Student[]
  teachers      Teacher[]
  announcements     Announcement[]
  events            Event[]
  exams             Exam[]
  attendanceRecords AttendanceRecord[]
  homework          Homework[]

  @@map("schools")
}

// ── Announcement ──────────────────────────────────────────────
model Announcement {
  id            String               @id @default(uuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id])
  title         String
  message       String
  audience      AnnouncementAudience @default(ALL)
  eventDate     DateTime?
  publishAt     DateTime?
  expiresAt     DateTime?
  createdBy     String
  createdByUser User                 @relation(fields: [createdBy], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([schoolId])
  @@map("announcements")
}

// ── Event ─────────────────────────────────────────────────────
// Fixed-date school events — holidays, exam schedules, meetings, etc.
model Event {
  id            String               @id @default(uuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id])
  title         String
  description   String?
  eventType     EventType
  audience      AnnouncementAudience @default(ALL)
  startDate     DateTime
  endDate       DateTime
  createdBy     String
  createdByUser User                 @relation(fields: [createdBy], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([schoolId])
  @@index([startDate])
  @@map("events")
}

// ── Exam ──────────────────────────────────────────────────────
model Exam {
  id            String       @id @default(uuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  title         String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  createdBy     String
  createdByUser User         @relation(fields: [createdBy], references: [id])
  classes       ExamClass[]
  results       ExamResult[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([schoolId])
  @@map("exams")
}

// ── ExamClass ─────────────────────────────────────────────────
// Which classes this exam applies to, and the max marks for that class
// (e.g. Class 5 exam out of 50, Class 10 exam out of 100).
model ExamClass {
  examId   String
  classId  String
  maxMarks Float
  exam     Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  class    Class @relation(fields: [classId], references: [id])

  @@id([examId, classId])
  @@map("exam_classes")
}

// ── ExamResult ────────────────────────────────────────────────
// One row per student per exam — marks/grade/status. classId is a
// snapshot of the student's class at grading time (not re-derived),
// so it stays historically accurate even if the student later moves classes.
model ExamResult {
  id            String       @id @default(uuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id])
  classId       String
  class         Class        @relation(fields: [classId], references: [id])
  marksObtained Float?
  grade         String?
  remarks       String?
  status        ResultStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([examId, studentId])
  @@map("exam_results")
}

// ── AttendanceRecord ────────────────────────────────────────────
// One row per student per calendar day. classId/sectionId are a
// snapshot at marking time (mirrors ExamResult's approach).
model AttendanceRecord {
  id           String           @id @default(uuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  classId      String
  class        Class            @relation(fields: [classId], references: [id])
  sectionId    String
  section      Section          @relation(fields: [sectionId], references: [id])
  date         DateTime         @db.Date
  status       AttendanceStatus
  markedBy     String
  markedByUser User             @relation(fields: [markedBy], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([classId, date])
  @@map("attendance_records")
}

// ── Homework ────────────────────────────────────────────────────
// Assigned by the subject teacher (must teach this subject in this
// class, via TeacherSubject — not restricted to the Class Teacher).
model Homework {
  id            String       @id @default(uuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  classId       String
  class         Class        @relation(fields: [classId], references: [id])
  sectionId     String
  section       Section      @relation(fields: [sectionId], references: [id])
  subjectId     String
  subject       Subject      @relation(fields: [subjectId], references: [id])
  title         String
  description   String?
  type          HomeworkType @default(ASSIGNMENT)
  dueDate       DateTime
  createdBy     String
  createdByUser User         @relation(fields: [createdBy], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([schoolId])
  @@index([classId, sectionId, dueDate])
  @@map("homework")
}

// ── RefreshToken ───────────────────────────────────────────────
model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ── DeviceToken ────────────────────────────────────────────────
model DeviceToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  platform  Platform?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// ── Class ─────────────────────────────────────────────────────
model Class {
  id              String           @id @default(uuid())
  name            String
  numericLevel    Int
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id])
  sections        Section[]
  students        Student[]
  subjects          ClassSubject[]
  teacherSubjects   TeacherSubject[]
  examClasses       ExamClass[]
  examResults       ExamResult[]
  attendanceRecords AttendanceRecord[]
  homework          Homework[]
  createdAt         DateTime           @default(now())

  @@unique([schoolId, name])
  @@map("classes")
}

// ── Section ───────────────────────────────────────────────────
model Section {
  id             String    @id @default(uuid())
  name           String
  classId        String
  class          Class     @relation(fields: [classId], references: [id])
  capacity       Int
  classTeacherId String?
  classTeacher   Teacher?  @relation(fields: [classTeacherId], references: [id])
  students       Student[]
  attendanceRecords AttendanceRecord[]
  homework       Homework[]

  @@unique([classId, name])
  @@map("sections")
}

// ── Subject ───────────────────────────────────────────────────
model Subject {
  id       String           @id @default(uuid())
  name     String
  schoolId String
  school   School           @relation(fields: [schoolId], references: [id])
  teachers TeacherSubject[]
  classes  ClassSubject[]
  homework Homework[]

  @@unique([schoolId, name])
  @@map("subjects")
}

// ── ClassSubject ──────────────────────────────────────────────
// Curriculum link: which subjects are taught in which class.
model ClassSubject {
  classId   String
  subjectId String
  class     Class   @relation(fields: [classId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([classId, subjectId])
  @@map("class_subjects")
}

// ── Student ───────────────────────────────────────────────────
model Student {
  id                   String   @id @default(uuid())
  admissionNo          String
  name                 String
  gender               Gender
  dateOfBirth          DateTime
  classId              String
  class                Class    @relation(fields: [classId], references: [id])
  sectionId            String
  section              Section  @relation(fields: [sectionId], references: [id])
  rollNo               Int
  parentUserId         String
  parentUser           User     @relation(fields: [parentUserId], references: [id])
  parentName           String
  parentPhone          String
  parentEmail          String
  bloodGroup           String?
  address              String?
  status               String   @default("ACTIVE")
  attendancePercentage Float    @default(100)
  schoolId             String
  school               School   @relation(fields: [schoolId], references: [id])
  examResults          ExamResult[]
  attendanceRecords    AttendanceRecord[]
  createdAt            DateTime @default(now())

  @@index([schoolId])
  @@map("students")
}

// ── Teacher ───────────────────────────────────────────────────
model Teacher {
  id                String           @id @default(uuid())
  employeeId        String
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id])
  gender            Gender
  joiningDate       DateTime
  salary            Float
  status            String           @default("ACTIVE")
  performanceScore  Float            @default(0)
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id])
  subjects          TeacherSubject[]
  sectionsAsTeacher Section[]

  @@index([schoolId])
  @@map("teachers")
}

// ── TeacherSubject ────────────────────────────────────────────
// Which teacher teaches which subject, in which class.
model TeacherSubject {
  teacherId String
  subjectId String
  classId   String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  class     Class   @relation(fields: [classId], references: [id])

  @@id([teacherId, subjectId, classId])
  @@map("teacher_subjects")
}
