// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────
enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  // Any role the super admin creates (Accountant, Librarian…). Which one
  // is on User.customRoleId — see CustomRole.
  STAFF
}

enum Platform {
  ANDROID
  IOS
  WEB
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AnnouncementAudience {
  ALL
  TEACHER
  PARENT
}

// HOLIDAY / GOVERNMENT_HOLIDAY / VACATION mean the school is closed on
// those dates (see SCHOOL_CLOSED_EVENT_TYPES) — the academic calendar
// counts them out of working days.
enum EventType {
  HOLIDAY
  GOVERNMENT_HOLIDAY
  VACATION
  EXAM
  MEETING
  ACTIVITY
  OTHER
}

enum ResultStatus {
  PENDING
  GRADED
  ABSENT
}

enum Board {
  CBSE
  ICSE
  STATE_BOARD
  IB
  OTHER
}

enum SchoolType {
  CO_ED
  BOYS
  GIRLS
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HomeworkType {
  ASSIGNMENT
  PROJECT
  READING
  PRACTICE
  OTHER
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  NOT_SUBMITTED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleType {
  CLASS_PERIOD
  BREAK
}

// ── User ──────────────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  // Optional login id (ADMIN / SUPER_ADMIN / TEACHER). Stored lowercase,
  // always starts with a letter so it can't be mistaken for a phone
  // number or email at login (see shared/utils/username.ts).
  username     String?  @unique
  passwordHash String
  profilePhoto String?
  role         Role
  // Nullable ONLY for SUPER_ADMIN — enforced in app code + a DB CHECK
  // constraint (see migration), since a super admin isn't scoped to a school.
  schoolId     String?
  // Set exactly when role = STAFF (DB CHECK constraint, see migration).
  customRoleId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school                        School?                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  customRole                    CustomRole?                   @relation("CustomRoleUsers", fields: [customRoleId], references: [id], onDelete: Restrict)
  customRolesCreated            CustomRole[]                  @relation("CustomRoleCreatedBy")
  feePaymentsCollected          FeePayment[]                  @relation("FeePaymentCollectedBy")
  salarySlipsCredited           SalarySlip[]                  @relation("SalarySlipCreditedBy")
  rolePermissionsUpdated        SchoolRolePermission[]        @relation("RolePermissionUpdatedBy")
  builtInRolePermissionsUpdated SchoolBuiltInRolePermission[] @relation("BuiltInRolePermissionUpdatedBy")
  refreshTokens                 RefreshToken[]
  loginOtps                     LoginOtp[]
  deviceTokens                  DeviceToken[]
  notifications                 Notification[]
  parentOfStudents              Student[]
  teacherProfile                Teacher?
  staffProfile                  Staff?
  announcementsCreated          Announcement[]
  eventsCreated                 Event[]
  examsCreated                  Exam[]
  examSchedulesCreated          ExamSchedule[]
  examMarksGraded               ExamMark[]
  attendanceMarked              AttendanceRecord[]
  homeworkCreated               Homework[]
  homeworkSubmissionsMarked     HomeworkSubmission[]
  classSchedulesCreated         ClassSchedule[]
  leaveRequestsApplied          LeaveRequest[]                @relation("LeaveAppliedBy")
  leaveRequestsReviewed         LeaveRequest[]                @relation("LeaveReviewedBy")
  teacherLeaveRequestsReviewed  TeacherLeaveRequest[]         @relation("TeacherLeaveReviewedBy")
  teacherAttendanceMarked       TeacherAttendanceRecord[]
  passwordResetTokens           PasswordResetToken[]
  supportQueriesCreated         SupportQuery[]                @relation("SupportQueryCreatedBy")
  supportQueriesReplied         SupportQuery[]                @relation("SupportQueryRepliedBy")
  subscriptions                 Subscription[]                @relation("SubscriptionUser")
  subscriptionsPaid             Subscription[]                @relation("SubscriptionPaidBy")
  subscriptionsActivated        Subscription[]                @relation("SubscriptionActivatedBy")
  payments                      Payment[]
  accountRecoveryRequests       AccountRecoveryRequest[]      @relation("AccountRecoveryUser")
  accountRecoveryResolved       AccountRecoveryRequest[]      @relation("AccountRecoveryResolvedBy")
  interventionsAssigned         Intervention[]                @relation("InterventionAssignedTo")
  interventionsCreated          Intervention[]                @relation("InterventionCreatedBy")
  chaptersCreated                Chapter[]                     @relation("ChapterCreatedBy")
  syllabusPlansCreated           SyllabusPlan[]                @relation("SyllabusPlanCreatedBy")
  progressHistoryUpdated         ChapterProgressHistory[]      @relation("ProgressHistoryUpdatedBy")
  progressApprovalsReviewed      ProgressApproval[]            @relation("ProgressApprovalReviewedBy")
  crashReports                   CrashReport[]
  promotionBatches               PromotionBatch[]              @relation("PromotionBatchBy")
  admissionsCreated              Admission[]                   @relation("AdmissionCreatedBy")
  parentQueriesCreated           ParentQuery[]                 @relation("ParentQueryCreatedBy")
  parentQueriesReplied           ParentQuery[]                 @relation("ParentQueryRepliedBy")

  @@index([schoolId])
  @@index([customRoleId])
  @@map("users")
}

// ── CustomRole — roles the super admin defines ─────────────────
// Shared by every school. key is the normalized identifier
// ("head clerk" → "HEAD_CLERK"): unique, uppercase and immutable, so apps
// can route on it. name is the editable display label. A role with users
// can't be deleted, only deactivated — deactivated roles are hidden from
// school admins and their users can't log in.
model CustomRole {
  id            String   @id @default(uuid())
  key           String   @unique
  name          String
  description   String?
  isActive      Boolean  @default(true)
  createdBy     String?
  createdByUser User?    @relation("CustomRoleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users             User[]                 @relation("CustomRoleUsers")
  staff             Staff[]                @relation("CustomRoleStaff")
  schoolPermissions SchoolRolePermission[]
  displayConfig     RoleDisplayConfig?

  @@map("custom_roles")
}

// ── SchoolRolePermission — what a school's admin lets a role do ──
// One row per (school, custom role); permissions has the same shape as
// School.permissions. A key the school has set to false stays false for
// every role in that school (see effectivePermissions). limits is the
// super admin's cap for this role in this school — same shape, and a key
// set to false there stays false whatever the admin saves.
model SchoolRolePermission {
  id            String     @id @default(uuid())
  schoolId      String
  school        School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  customRoleId  String
  customRole    CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  permissions   Json       @default("{}")
  limits        Json       @default("{}")
  updatedBy     String?
  updatedByUser User?      @relation("RolePermissionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([schoolId, customRoleId])
  @@map("school_role_permissions")
}

// ── SchoolBuiltInRolePermission — same (incl. limits), for TEACHER / PARENT 
// Built-in roles aren't CustomRole rows, so they get their own table,
// keyed by the Role enum. Only TEACHER and PARENT (DB CHECK constraint):
// ADMIN gets the whole school's permissions, SUPER_ADMIN isn't scoped.
model SchoolBuiltInRolePermission {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role          Role
  permissions   Json     @default("{}")
  limits        Json     @default("{}")
  updatedBy     String?
  updatedByUser User?    @relation("BuiltInRolePermissionUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, role])
  @@map("school_builtin_role_permissions")
}

// ── School ────────────────────────────────────────────────────
model School {
  id   String  @id @default(uuid())
  name String
  // Human-friendly unique identifier, e.g. "SCH0001" — auto-generated at
  // creation if not supplied. Immutable once set (not in the update schema).
  code String? @unique

  board           Board?
  schoolType      SchoolType?
  medium          String?
  establishedYear Int?
  logoUrl         String?

  // ── Location ──────────────────────────────────────────────────
  // city/contactEmail are REQUIRED going forward (enforced in the create
  // validation, not here) — kept nullable at the DB level only because
  // existing rows predate this and shouldn't be force-backfilled.
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  country      String? @default("India")
  latitude     Float?
  longitude    Float?

  // ── Contact ───────────────────────────────────────────────────
  contactEmail   String?
  contactPhone   String?
  alternatePhone String?
  websiteUrl     String?

  // ── Principal / Head ──────────────────────────────────────────
  principalName  String?
  principalEmail String?
  principalPhone String?

  // ── Academic ──────────────────────────────────────────────────
  totalStudentsApprox       Int?
  totalStaffApprox          Int?
  classesFrom               String?
  classesTo                 String?
  academicSessionStartMonth Int?

  // What the super admin allows this school — a flat JSON object with
  // camelCase keys chosen by the UI (values: boolean / number / string /
  // array of those). The backend stores it as-is; see features/permissions.
  permissions Json @default("{}")

  createdAt DateTime @default(now())

  users                    User[]
  classes                  Class[]
  subjects                 Subject[]
  students                 Student[]
  teachers                 Teacher[]
  announcements            Announcement[]
  events                   Event[]
  exams                    Exam[]
  attendanceRecords        AttendanceRecord[]
  homework                 Homework[]
  classSchedules           ClassSchedule[]
  examSchedules            ExamSchedule[]
  leaveRequests            LeaveRequest[]
  teacherLeaveRequests     TeacherLeaveRequest[]
  teacherAttendanceRecords TeacherAttendanceRecord[]
  staff                    Staff[]
  supportQueries           SupportQuery[]
  accountRecoveryRequests  AccountRecoveryRequest[]
  interventions            Intervention[]
  feeStructures            FeeStructure[]
  studentFees              StudentFee[]
  feePayments              FeePayment[]
  salarySlips              SalarySlip[]
  sequences                SchoolSequence[]
  rolePermissions          SchoolRolePermission[]
  builtInRolePermissions   SchoolBuiltInRolePermission[]
  subscriptionPlans        SubscriptionPlan[]
  subscriptions            Subscription[]
  payments                 Payment[]
  chapters                 Chapter[]
  syllabusPlans            SyllabusPlan[]
  academicSessions         AcademicSession[]
  promotionBatches         PromotionBatch[]
  admissions               Admission[]
  parentQueries            ParentQuery[]

  @@map("schools")
}

// ── Announcement ──────────────────────────────────────────────
model Announcement {
  id            String               @id @default(uuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id])
  title         String
  message       String
  audience      AnnouncementAudience @default(ALL)
  eventDate     DateTime?
  publishAt     DateTime?
  expiresAt     DateTime?
  createdBy     String
  createdByUser User                 @relation(fields: [createdBy], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([schoolId])
  @@map("announcements")
}

// ── Event ─────────────────────────────────────────────────────
// Fixed-date school events — holidays, exam schedules, meetings, etc.
model Event {
  id            String               @id @default(uuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id])
  title         String
  description   String?
  eventType     EventType
  audience      AnnouncementAudience @default(ALL)
  startDate     DateTime
  endDate       DateTime
  createdBy     String
  createdByUser User                 @relation(fields: [createdBy], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([schoolId])
  @@index([startDate])
  @@map("events")
}

// ── Exam ──────────────────────────────────────────────────────
model Exam {
  id            String         @id @default(uuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id])
  title         String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  createdBy     String
  createdByUser User           @relation(fields: [createdBy], references: [id])
  classes       ExamClass[]
  results       ExamResult[]
  schedules     ExamSchedule[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([schoolId])
  @@map("exams")
}

// ── ExamClass ─────────────────────────────────────────────────
// Which classes this exam applies to, and the max marks for that class
// (e.g. Class 5 exam out of 50, Class 10 exam out of 100).
model ExamClass {
  examId   String
  classId  String
  maxMarks Float
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  class    Class  @relation(fields: [classId], references: [id])

  @@id([examId, classId])
  @@map("exam_classes")
}

// ── ExamResult ────────────────────────────────────────────────
// One row per student per exam — marks/grade/status. classId is a
// snapshot of the student's class at grading time (not re-derived),
// so it stays historically accurate even if the student later moves classes.
model ExamResult {
  id            String       @id @default(uuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id])
  classId       String
  class         Class        @relation(fields: [classId], references: [id])
  marksObtained Float?
  grade         String?
  remarks       String?
  status        ResultStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([examId, studentId])
  @@map("exam_results")
}

// ── ExamSchedule — one paper in an exam's date sheet ───────────────
// Which subject a class sits on which date/time, its max marks, the room,
// and the teacher invigilating. One paper per (exam, class, subject).
// All sections of a class sit the paper together. date is date-only;
// startTime/endTime are "HH:MM" 24-hour strings (same as ClassSchedule).
// Overlap rules (class / invigilator / room on the same date) are enforced
// in the service, under a per-school lock — see examSchedule.service.ts.
model ExamSchedule {
  id            String     @id @default(uuid())
  schoolId      String
  school        School     @relation(fields: [schoolId], references: [id])
  examId        String
  exam          Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId       String
  class         Class      @relation(fields: [classId], references: [id])
  subjectId     String
  subject       Subject    @relation(fields: [subjectId], references: [id])
  date          DateTime   @db.Date
  startTime     String
  endTime       String
  maxMarks      Float
  roomNo        String?
  invigilatorId String?
  invigilator   Teacher?   @relation(fields: [invigilatorId], references: [id], onDelete: SetNull)
  createdBy     String
  createdByUser User       @relation(fields: [createdBy], references: [id])
  marks         ExamMark[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([examId, classId, subjectId])
  @@index([schoolId, date])
  @@index([classId, date])
  @@index([invigilatorId, date])
  @@map("exam_schedules")
}

// ── ExamMark — one student's marks on one paper (subject) ───────────
// Entered by the subject's teacher (or an admin). ExamResult above stays
// the exam-level overall result; this is the per-subject breakdown.
model ExamMark {
  id             String       @id @default(uuid())
  examScheduleId String
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  marksObtained  Float?
  grade          String?
  remarks        String?
  status         ResultStatus @default(PENDING)
  gradedBy       String?
  gradedByUser   User?        @relation(fields: [gradedBy], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([examScheduleId, studentId])
  @@index([studentId])
  @@map("exam_marks")
}

// ── AttendanceRecord ────────────────────────────────────────────
// One row per student per calendar day. classId/sectionId are a
// snapshot at marking time (mirrors ExamResult's approach).
model AttendanceRecord {
  id           String           @id @default(uuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  classId      String
  class        Class            @relation(fields: [classId], references: [id])
  sectionId    String
  section      Section          @relation(fields: [sectionId], references: [id])
  date         DateTime         @db.Date
  status       AttendanceStatus
  markedBy     String
  markedByUser User             @relation(fields: [markedBy], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([classId, date])
  @@map("attendance_records")
}

// ── Homework ────────────────────────────────────────────────────
// Assigned by the subject teacher (must teach this subject in this
// class, via TeacherSubject — not restricted to the Class Teacher).
model Homework {
  id            String       @id @default(uuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  classId       String
  class         Class        @relation(fields: [classId], references: [id])
  sectionId     String
  section       Section      @relation(fields: [sectionId], references: [id])
  subjectId     String
  subject       Subject      @relation(fields: [subjectId], references: [id])
  title         String
  description   String?
  type          HomeworkType @default(ASSIGNMENT)
  // Optional — when set, the frontend uses it to decide when to reveal
  // this homework to the class. While it's still in the future, the
  // computed status is SCHEDULED regardless of the `status` column below
  // (see src/shared/utils/homeworkStatus.ts).
  fromDate      DateTime?
  dueDate       DateTime
  // Teacher-managed progress marker — only ever ACTIVE/IN_PROGRESS/COMPLETED
  // are actually stored here; SCHEDULED is computed, never written (see
  // computeHomeworkStatus). Deliberately separate from `isActive` below —
  // that's the soft-delete flag, this is the workflow stage.
  status        String       @default("ACTIVE")
  // Soft delete — see deleteHomework in teacher.service.ts. Kept as its
  // own boolean (not folded into `status`) so "deleted" can never be
  // confused with "not yet started" or any other workflow stage.
  isActive      Boolean      @default(true)
  createdBy     String
  createdByUser User         @relation(fields: [createdBy], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  submissions HomeworkSubmission[]

  @@index([schoolId])
  @@index([classId, sectionId, dueDate])
  @@index([schoolId, dueDate])
  @@map("homework")
}

// ── HomeworkSubmission ────────────────────────────────────────
// Lazily created — a row exists only once a teacher has actually marked
// a student for a given homework. A student with no row here is simply
// "not yet checked" (surfaced as status: null in the API), not the same
// as an explicit NOT_SUBMITTED.
model HomeworkSubmission {
  id           String                   @id @default(uuid())
  homeworkId   String
  homework     Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       HomeworkSubmissionStatus
  remarks      String?
  markedBy     String
  markedByUser User                     @relation(fields: [markedBy], references: [id])
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
  @@map("homework_submissions")
}

// ── ClassSchedule ─────────────────────────────────────────────────
// One row = one period (or break) for a section, on a given day of
// the week. "School timing" and "teacher schedule" are NOT separate
// tables — both are just views/queries over this same table (derived,
// not stored, so there's nothing to keep in sync).
model ClassSchedule {
  id            String       @id @default(uuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  classId       String
  class         Class        @relation(fields: [classId], references: [id])
  sectionId     String
  section       Section      @relation(fields: [sectionId], references: [id])
  day           DayOfWeek
  type          ScheduleType
  periodNo      Int
  subjectId     String?
  subject       Subject?     @relation(fields: [subjectId], references: [id])
  teacherId     String?
  teacher       Teacher?     @relation(fields: [teacherId], references: [id])
  roomNo        String?
  title         String?
  startTime     String // "HH:MM", 24-hour, no date component
  endTime       String // "HH:MM", 24-hour, no date component
  createdBy     String
  createdByUser User         @relation(fields: [createdBy], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([sectionId, day, periodNo])
  @@index([schoolId])
  @@index([teacherId, day])
  @@index([roomNo, day])
  @@map("class_schedules")
}

// ── RefreshToken ───────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ── PasswordResetToken — forgot-password OTP ─────────────────────
// codeHash is a bcrypt hash of the 6-digit OTP, never the plaintext —
// so a DB leak alone can't be used to reset anyone's password.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── LoginOtp — mobile number + OTP login ─────────────────────────
// codeHash is a bcrypt hash of the 6-digit OTP, never the plaintext.
// Rows are invalidated (used = true), not deleted, when a new OTP is
// issued, so they also serve as the per-hour send counter.
model LoginOtp {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_otps")
}

// ── DeviceToken ────────────────────────────────────────────────
model DeviceToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  platform  Platform?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// ── Notification ─────────────────────────────────────────────────
// In-app record of every notification a user has been sent — independent
// of whether the push itself was delivered (device offline, no token
// registered, Firebase not configured, etc.). This is the source of
// truth for the mobile "notification inbox"; push is just the "ding".
// `type` is a plain string (not an enum) on purpose — new features can
// introduce new notification types without a schema migration, as long
// as they pass a `type` inside PushPayload.data (see notifications.service.ts).
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String    @default("GENERAL")
  data      Json      @default("{}")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

// ── Class ─────────────────────────────────────────────────────
model Class {
  id                String             @id @default(uuid())
  name              String
  numericLevel      Int
  schoolId          String
  school            School             @relation(fields: [schoolId], references: [id])
  sections          Section[]
  students          Student[]
  subjects          ClassSubject[]
  teacherSubjects   TeacherSubject[]
  examClasses       ExamClass[]
  examResults       ExamResult[]
  examSchedules     ExamSchedule[]
  attendanceRecords AttendanceRecord[]
  homework          Homework[]
  classSchedules    ClassSchedule[]
  feeStructures        FeeStructure[]
  leaveRequests        LeaveRequest[]
  chapters             Chapter[]
  syllabusPlans        SyllabusPlan[]
  promotionsFrom       PromotionBatch[]   @relation("PromotionFromClass")
  promotionsTo         PromotionBatch[]   @relation("PromotionToClass")
  admissions           Admission[]
  createdAt            DateTime           @default(now())

  @@unique([schoolId, name])
  @@map("classes")
}

// ── Section ───────────────────────────────────────────────────
model Section {
  id                String             @id @default(uuid())
  name              String
  classId           String
  class             Class              @relation(fields: [classId], references: [id])
  capacity          Int
  classTeacherId    String?
  classTeacher      Teacher?           @relation(fields: [classTeacherId], references: [id])
  students          Student[]
  attendanceRecords AttendanceRecord[]
  homework          Homework[]
  classSchedules    ClassSchedule[]
  leaveRequests     LeaveRequest[]
  syllabusPlans     SyllabusPlan[]

  @@unique([classId, name])
  @@map("sections")
}

// ── Subject ───────────────────────────────────────────────────
model Subject {
  id             String           @id @default(uuid())
  name           String
  description    String?
  isActive       Boolean          @default(true)
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id])
  teachers       TeacherSubject[]
  classes        ClassSubject[]
  homework       Homework[]
  classSchedules ClassSchedule[]
  examSchedules  ExamSchedule[]
  chapters       Chapter[]
  syllabusPlans  SyllabusPlan[]

  @@unique([schoolId, name])
  @@map("subjects")
}

// ── ClassSubject ──────────────────────────────────────────────
// Curriculum link: which subjects are taught in which class.
model ClassSubject {
  classId   String
  subjectId String
  class     Class   @relation(fields: [classId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([classId, subjectId])
  @@map("class_subjects")
}

// ── Student ───────────────────────────────────────────────────
model Student {
  id                   String               @id @default(uuid())
  admissionNo          String
  name                 String
  gender               Gender
  dateOfBirth          DateTime
  classId              String
  class                Class                @relation(fields: [classId], references: [id])
  sectionId            String
  section              Section              @relation(fields: [sectionId], references: [id])
  rollNo               Int
  parentUserId         String
  parentUser           User                 @relation(fields: [parentUserId], references: [id])
  parentName           String
  parentPhone          String
  parentEmail          String
  bloodGroup           String?
  address              String?
  status               String               @default("ACTIVE")
  attendancePercentage Float                @default(100)
  schoolId             String
  school               School               @relation(fields: [schoolId], references: [id])
  examResults          ExamResult[]
  examMarks            ExamMark[]
  attendanceRecords    AttendanceRecord[]
  leaveRequests        LeaveRequest[]
  fees                 StudentFee[]
  homeworkSubmissions  HomeworkSubmission[]
  promotionRecords     PromotionRecord[]
  createdAt            DateTime             @default(now())

  @@index([schoolId])
  @@index([schoolId, status, sectionId])
  @@map("students")
}

// ── Teacher ───────────────────────────────────────────────────
model Teacher {
  id                String                    @id @default(uuid())
  employeeId        String
  userId            String                    @unique
  user              User                      @relation(fields: [userId], references: [id])
  gender            Gender
  joiningDate       DateTime
  salary            Float
  qualification     String                    @default("")
  experienceYears   Int                       @default(0)
  experienceMonths  Int                       @default(0)
  // Subjects this teacher is generally qualified to teach — a plain name
  // list, not tied to any class. Actual class+subject scheduling
  // assignments still live in TeacherSubject (via assign-subject endpoint).
  subjectsTaught    String[]                  @default([])
  status            String                    @default("ACTIVE")
  performanceScore  Float                     @default(0)
  schoolId          String
  school            School                    @relation(fields: [schoolId], references: [id])
  subjects          TeacherSubject[]
  sectionsAsTeacher Section[]
  classSchedules    ClassSchedule[]
  examInvigilations ExamSchedule[]
  leaveRequests     TeacherLeaveRequest[]
  salarySlips       SalarySlip[]
  attendanceRecords TeacherAttendanceRecord[]
  syllabusPlans     SyllabusPlan[]

  @@index([schoolId])
  @@map("teachers")
}

// ── TeacherSubject ────────────────────────────────────────────
// Which teacher teaches which subject, in which class.
model TeacherSubject {
  teacherId String
  subjectId String
  classId   String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  class     Class   @relation(fields: [classId], references: [id])

  @@id([teacherId, subjectId, classId])
  @@map("teacher_subjects")
}

// ── LeaveRequest ──────────────────────────────────────────────
// A parent applies for their child's leave; either the Class Teacher
// of the section or an Admin can approve/reject. Approval auto-marks
// AttendanceRecord as LEAVE for every date in [fromDate, toDate].
model LeaveRequest {
  id             String      @id @default(uuid())
  schoolId       String
  school         School      @relation(fields: [schoolId], references: [id])
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id])
  classId        String
  class          Class       @relation(fields: [classId], references: [id])
  sectionId      String
  section        Section     @relation(fields: [sectionId], references: [id])
  fromDate       DateTime    @db.Date
  toDate         DateTime    @db.Date
  reason         String
  status         LeaveStatus @default(PENDING)
  appliedBy      String
  appliedByUser  User        @relation("LeaveAppliedBy", fields: [appliedBy], references: [id])
  reviewedBy     String?
  reviewedByUser User?       @relation("LeaveReviewedBy", fields: [reviewedBy], references: [id])
  reviewedAt     DateTime?
  reviewRemarks  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([sectionId, status])
  @@map("leave_requests")
}

// ── TeacherLeaveRequest ───────────────────────────────────────
// A teacher's own leave — separate from LeaveRequest (student leave)
// since there's no student/class/section context here, only Admin
// reviews it (no "class teacher of the teacher" concept), and there's
// no attendance record to auto-mark (staff attendance isn't tracked).
model TeacherLeaveRequest {
  id             String      @id @default(uuid())
  schoolId       String
  school         School      @relation(fields: [schoolId], references: [id])
  teacherId      String
  teacher        Teacher     @relation(fields: [teacherId], references: [id])
  fromDate       DateTime    @db.Date
  toDate         DateTime    @db.Date
  reason         String
  status         LeaveStatus @default(PENDING)
  reviewedBy     String?
  reviewedByUser User?       @relation("TeacherLeaveReviewedBy", fields: [reviewedBy], references: [id])
  reviewedAt     DateTime?
  reviewRemarks  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([schoolId])
  @@index([teacherId])
  @@map("teacher_leave_requests")
}

// ── TeacherAttendanceRecord ───────────────────────────────────
// Staff attendance — ADMIN-only (no "class teacher of the teacher"
// concept). One row per teacher per calendar day, same AttendanceStatus
// enum as student attendance so both share the same status vocabulary.
model TeacherAttendanceRecord {
  id                       String            @id @default(uuid())
  schoolId                 String
  school                   School            @relation(fields: [schoolId], references: [id])
  teacherId                String
  teacher                  Teacher           @relation(fields: [teacherId], references: [id])
  date                     DateTime          @db.Date
  // Teacher's own check-in for the day (null until they check in).
  teacherStatus            AttendanceStatus?
  teacherMarkedAt          DateTime?
  // Device location at check-in (null if the app didn't send it).
  teacherLatitude          Float?
  teacherLongitude         Float?
  // Teacher's own check-out for the day (null until they check out).
  teacherCheckOutAt        DateTime?
  teacherCheckOutLatitude  Float?
  teacherCheckOutLongitude Float?
  // Admin's marking for the day (null until an admin marks it).
  adminStatus              AttendanceStatus?
  adminMarkedBy            String?
  adminMarkedByUser        User?             @relation(fields: [adminMarkedBy], references: [id])
  adminMarkedAt            DateTime?
  // Final status used by reports/filters = adminStatus ?? teacherStatus.
  // Stored (not computed) so queries stay simple; every write keeps it in sync.
  status                   AttendanceStatus
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@unique([teacherId, date])
  @@index([schoolId, date])
  @@map("teacher_attendance_records")
}

// ── Staff ─────────────────────────────────────────────────────
// Non-teaching staff (accountant, librarian, driver, peon, etc.) —
// a plain record managed by Admin. designation is picked from the
// CustomRole list; customRoleId links to it so staff can be grouped
// by role. designation stays as a snapshot label.
model Staff {
  id               String       @id @default(uuid())
  employeeId       String
  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  name             String
  email            String?
  phone            String
  gender           Gender
  designation      String
  customRoleId     String?
  customRole       CustomRole?  @relation("CustomRoleStaff", fields: [customRoleId], references: [id], onDelete: Restrict)
  salary           Float
  qualification    String       @default("")
  experienceYears  Int          @default(0)
  experienceMonths Int          @default(0)
  joiningDate      DateTime
  salarySlips      SalarySlip[]
  status           String       @default("ACTIVE")
  schoolId         String
  school           School       @relation(fields: [schoolId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([schoolId])
  @@index([customRoleId])
  @@map("staff")
}

// ── SupportQuery — help & support requests ─────────────────────────
// Raised by a school ADMIN, TEACHER or PARENT; answered by SUPER_ADMIN.
// message/reply hold HTML from a rich-text editor, always stored already
// sanitized (see shared/utils/sanitizeHtml.ts). category is a plain string
// validated against SUPPORT_QUERY_CATEGORIES (its labels contain spaces
// and "/", which a Prisma enum can't hold).
enum SupportQueryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportQuery {
  id            String             @id @default(uuid())
  schoolId      String
  school        School             @relation(fields: [schoolId], references: [id])
  createdBy     String
  createdByUser User               @relation("SupportQueryCreatedBy", fields: [createdBy], references: [id])
  // Role of the sender when the query was raised (snapshot).
  createdByRole Role
  subject       String
  category      String?
  message       String
  status        SupportQueryStatus @default(OPEN)
  reply         String?
  repliedAt     DateTime?
  repliedBy     String?
  repliedByUser User?              @relation("SupportQueryRepliedBy", fields: [repliedBy], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([schoolId, createdBy, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("support_queries")
}

// ── AccountRecoveryRequest — "request admin" from the login screen ──
// Raised WITHOUT logging in by a TEACHER/PARENT who forgot their
// email/password/phone. The submitted contact details are matched to an
// account at submit time; unmatched requests are never stored. Only one
// PENDING request per user — re-submitting updates it. The school ADMIN
// resolves it by hard-resetting the password to the default.
enum AccountRecoveryStatus {
  PENDING
  RESOLVED
  REJECTED
}

model AccountRecoveryRequest {
  id             String                @id @default(uuid())
  schoolId       String
  school         School                @relation(fields: [schoolId], references: [id])
  userId         String
  user           User                  @relation("AccountRecoveryUser", fields: [userId], references: [id], onDelete: Cascade)
  // Exactly what the requester typed (phones normalized to national number).
  name           String
  email          String?
  phones         String[]
  status         AccountRecoveryStatus @default(PENDING)
  resolvedAt     DateTime?
  resolvedBy     String?
  resolvedByUser User?                 @relation("AccountRecoveryResolvedBy", fields: [resolvedBy], references: [id])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([schoolId, status, createdAt(sort: Desc)])
  @@index([userId, status])
  @@map("account_recovery_requests")
}

// ── Intervention — action taken on an analytics alert ──────────────
// Alerts themselves are computed on the fly (admin/analytics/alerts) and
// never stored; an intervention is the admin's record of acting on one.
// alertKey is the alert's deterministic key ("LOW_ATTENDANCE:<studentId>:
// <periodStart>") so the alert list can show its status. entityType /
// entityId name what it's about (validated against the school on create)
// — plain columns rather than one FK per entity type.
enum InterventionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Intervention {
  id             String             @id @default(uuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id])
  alertKey       String?
  alertType      String?
  entityType     String
  entityId       String
  title          String
  description    String?
  actionTaken    String?
  status         InterventionStatus @default(OPEN)
  assignedTo     String?
  assignedToUser User?              @relation("InterventionAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  dueDate        DateTime?          @db.Date
  followUpDate   DateTime?          @db.Date
  outcome        String?
  completedAt    DateTime?
  createdBy      String
  createdByUser  User               @relation("InterventionCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([schoolId, status, dueDate])
  @@index([schoolId, alertKey])
  @@index([schoolId, entityType, entityId])
  @@index([assignedTo, status])
  @@map("interventions")
}

// ══════════════════════════════════════════════════════════════════
// Subscriptions
// ──────────────────────────────────────────────────────────────────
// Feature            — a lockable piece of the app ("homework", "ad_free").
//                      isPaid = false → free for everyone, never checked.
// SubscriptionPlan   — what's sold; SELF plans are bought by a user for
//                      themselves, SCHOOL plans by a school ADMIN for the
//                      whole school.
// PlanFeature        — which features a plan unlocks, and for which role
//                      (a SCHOOL plan can give parents and teachers
//                      different features).
// PlanPrice          — duration options of a plan: intervalCount ×
//                      intervalUnit (1 MONTH, 3 MONTH, 6 MONTH, 1 YEAR…).
// Subscription       — one purchased period. No auto-renew: renewing
//                      creates a new row starting where the last one ends.
// Payment            — money received against a subscription.
//
// Subscription.status only stores what happened (PENDING / ACTIVE /
// FAILED / CANCELLED); EXPIRED, UPCOMING and EXPIRING_SOON are computed
// from startDate/endDate at read time (see subscriptionStatus.ts), so
// no cron job is needed for access to stop on time.
// ══════════════════════════════════════════════════════════════════
enum PlanScope {
  SELF
  SCHOOL
}

enum PlanType {
  BASE
  ADDON
}

enum IntervalUnit {
  DAY
  MONTH
  YEAR
}

enum SubscriberType {
  USER
  SCHOOL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  FAILED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentGateway {
  MANUAL
  RAZORPAY
}

model Feature {
  id          String   @id @default(uuid())
  // Stable identifier used in code (requireFeature('homework')).
  key         String   @unique
  name        String
  description String?
  isPaid      Boolean  @default(true)
  // Roles this feature applies to.
  roles       Role[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans PlanFeature[]

  @@map("features")
}

model SubscriptionPlan {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  description   String?
  scope         PlanScope @default(SELF)
  planType      PlanType  @default(BASE)
  // Roles that can see and buy it — always [ADMIN] for SCHOOL plans.
  targetRoles   Role[]
  // null → offered to every school; set → only to this school.
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  // Free trial window: inside it, everyone the plan is offered to gets its
  // features without paying. trialEndsAt is exclusive (00:00 IST the day
  // after the last trial day).
  trialStartsAt DateTime?
  trialEndsAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  features      PlanFeature[]
  prices        PlanPrice[]
  subscriptions Subscription[]

  @@index([isActive])
  @@map("subscription_plans")
}

model PlanFeature {
  id        String           @id @default(uuid())
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature          @relation(fields: [featureId], references: [id], onDelete: Restrict)
  // Role that gets this feature through the plan.
  role      Role
  createdAt DateTime         @default(now())

  @@unique([planId, featureId, role])
  @@index([featureId])
  @@map("plan_features")
}

model PlanPrice {
  id            String           @id @default(uuid())
  planId        String
  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  label         String?
  intervalUnit  IntervalUnit
  intervalCount Int
  // Paise (₹1 = 100).
  amount        Int
  currency      String           @default("INR")
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  subscriptions Subscription[]

  @@unique([planId, intervalUnit, intervalCount])
  @@map("plan_prices")
}

model Subscription {
  id             String         @id @default(uuid())
  subscriberType SubscriberType
  // Set for USER subscriptions, null for SCHOOL ones.
  userId         String?
  user           User?          @relation("SubscriptionUser", fields: [userId], references: [id], onDelete: Restrict)
  schoolId       String
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  // Role of the buyer at purchase time (snapshot).
  role           Role
  paidByUserId   String
  paidByUser     User           @relation("SubscriptionPaidBy", fields: [paidByUserId], references: [id], onDelete: Restrict)

  planId        String
  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPriceId   String
  planPrice     PlanPrice        @relation(fields: [planPriceId], references: [id], onDelete: Restrict)
  // Price as it was when bought — later price edits don't touch it.
  amount        Int
  currency      String           @default("INR")
  intervalUnit  IntervalUnit
  intervalCount Int

  status          SubscriptionStatus @default(PENDING)
  // Set on activation; null while PENDING.
  startDate       DateTime?
  endDate         DateTime?
  activatedAt     DateTime?
  // Set when a SUPER_ADMIN activated it by hand (offline payment / grant).
  activatedBy     String?
  activatedByUser User?              @relation("SubscriptionActivatedBy", fields: [activatedBy], references: [id], onDelete: SetNull)
  cancelledAt     DateTime?
  note            String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  payments Payment[]

  @@index([userId, status, endDate])
  @@index([schoolId, subscriberType, status, endDate])
  @@index([planId])
  @@map("subscriptions")
}

model Payment {
  id               String         @id @default(uuid())
  subscriptionId   String
  subscription     Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  schoolId         String
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  amount           Int
  currency         String         @default("INR")
  status           PaymentStatus  @default(CREATED)
  gateway          PaymentGateway @default(MANUAL)
  gatewayOrderId   String?
  // Unique so a gateway payment can never be counted twice.
  gatewayPaymentId String?        @unique
  // Free-text reference for manual payments (UTR, cheque no., …).
  reference        String?
  rawResponse      Json?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([subscriptionId])
  @@index([schoolId, createdAt(sort: Desc)])
  @@map("payments")
}

// ════════════════════════════════════════════════════════════
// Student fees
//   FeeStructure — a fee the school charges ("Tuition Q1", ₹12,000, due
//                  15 Jul) for one session, for one class or all classes.
//   StudentFee   — that fee assigned to one student (amounts copied, so
//                  editing the structure later never changes a bill), or
//                  an ad-hoc charge with no structure.
//   FeePayment   — money received against one StudentFee. Never deleted:
//                  a wrong entry is VOIDED, which recomputes the fee.
// Amounts are rupees with paise (Decimal 12,2). sessionYear is the year
// the academic session starts in (2026 → 2026-27), as in analytics.
// ════════════════════════════════════════════════════════════

enum FeeStatus {
  PENDING // nothing paid yet
  PARTIAL // something paid, balance left
  PAID // fully paid (or payable is 0)
  WAIVED // balance forgiven by the school
  CANCELLED // charge withdrawn (only when nothing was paid)
}

enum FeePaymentStatus {
  SUCCESS
  VOIDED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

model FeeStructure {
  id          String       @id @default(uuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name        String
  category    String
  description String?
  amount      Decimal      @db.Decimal(12, 2)
  dueDate     DateTime     @db.Date
  sessionYear Int
  // null = every class
  classId     String?
  class       Class?       @relation(fields: [classId], references: [id], onDelete: Restrict)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  studentFees StudentFee[]

  @@index([schoolId, sessionYear])
  @@map("fee_structures")
}

model StudentFee {
  id             String        @id @default(uuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  title          String
  category       String
  sessionYear    Int
  amount         Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  fine           Decimal       @default(0) @db.Decimal(12, 2)
  // Sum of SUCCESS payments — kept in step by the payment/void code.
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  dueDate        DateTime      @db.Date
  status         FeeStatus     @default(PENDING)
  statusReason   String?
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  payments       FeePayment[]

  // A structure is assigned to a student at most once.
  @@unique([studentId, feeStructureId])
  @@index([schoolId, sessionYear, status])
  @@index([schoolId, status, dueDate])
  @@map("student_fees")
}

model FeePayment {
  id              String           @id @default(uuid())
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentFeeId    String
  studentFee      StudentFee       @relation(fields: [studentFeeId], references: [id], onDelete: Restrict)
  studentId       String
  receiptNo       String
  amount          Decimal          @db.Decimal(12, 2)
  mode            PaymentMode
  referenceNo     String?
  paidAt          DateTime
  note            String?
  status          FeePaymentStatus @default(SUCCESS)
  voidReason      String?
  voidedAt        DateTime?
  collectedBy     String?
  collectedByUser User?            @relation("FeePaymentCollectedBy", fields: [collectedBy], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@unique([schoolId, receiptNo])
  @@index([studentFeeId])
  @@index([studentId])
  @@index([schoolId, paidAt])
  @@map("fee_payments")
}

// ════════════════════════════════════════════════════════════
// Salary — one SalarySlip per employee per month. Employee is a Teacher
// (has a login, sees their slips) or a Staff record (no login). Name,
// code and base salary are copied at generation so a later raise or
// rename doesn't rewrite old slips.
//   PENDING → CREDITED (paid)      PENDING ⇄ ON_HOLD      → CANCELLED
// ════════════════════════════════════════════════════════════

enum SalaryStatus {
  PENDING
  ON_HOLD
  CREDITED
  CANCELLED
}

enum EmployeeType {
  TEACHER
  STAFF
}

model SalarySlip {
  id              String       @id @default(uuid())
  schoolId        String
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  slipNo          String
  employeeType    EmployeeType
  teacherId       String?
  teacher         Teacher?     @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  staffId         String?
  staff           Staff?       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  employeeName    String
  employeeCode    String
  month           Int
  year            Int
  baseSalary      Decimal      @db.Decimal(12, 2)
  // [{ label, amount }]
  allowances      Json         @default("[]")
  deductions      Json         @default("[]")
  grossAmount     Decimal      @db.Decimal(12, 2)
  totalDeductions Decimal      @db.Decimal(12, 2)
  netAmount       Decimal      @db.Decimal(12, 2)
  status          SalaryStatus @default(PENDING)
  statusReason    String?
  note            String?
  paymentMode     PaymentMode?
  referenceNo     String?
  creditedAt      DateTime?
  creditedBy      String?
  creditedByUser  User?        @relation("SalarySlipCreditedBy", fields: [creditedBy], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([teacherId, month, year])
  @@unique([staffId, month, year])
  @@unique([schoolId, slipNo])
  @@index([schoolId, year, month, status])
  @@map("salary_slips")
}

// ── SchoolSequence — gap-free-ish running numbers per school ──
// (fee receipts, salary slips). Incremented atomically in SQL, see
// shared/utils/sequence.ts.
model SchoolSequence {
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  value    Int    @default(0)

  @@id([schoolId, name])
  @@map("school_sequences")
}

// ── RoleDisplayConfig — which roles appear on the login screen ────
// One row per displayable role. Exactly one of builtInRole / customRoleId
// is set (DB CHECK). Super admin configures showOnWeb / showOnMobile so
// the login screen on each platform only lists the relevant roles.
model RoleDisplayConfig {
  id           String      @id @default(uuid())
  builtInRole  Role?       @unique
  customRoleId String?     @unique
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  label        String
  showOnWeb    Boolean     @default(true)
  showOnMobile Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("role_display_configs")
}

// ══════════════════════════════════════════════════════════════════
// Syllabus Management & Academic Progress Tracking
// ──────────────────────────────────────────────────────────────────
// Chapter        — a curriculum chapter for a subject in a class.
// SyllabusPlan   — a session-year plan linking class + section +
//                  subject + teacher; holds the admin's planned dates.
// SyllabusPlanChapter — one chapter inside a plan, with both admin
//                  planning fields (expected days, planned dates) and
//                  teacher progress fields (actual days, completion %).
// ChapterProgressHistory — audit trail of every teacher progress
//                  submission (immutable append-only log).
// ProgressApproval — optional admin review/correction workflow.
// ══════════════════════════════════════════════════════════════════

model Chapter {
  id                  String   @id @default(uuid())
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id])
  subjectId           String
  subject             Subject  @relation(fields: [subjectId], references: [id])
  classId             String
  class               Class    @relation(fields: [classId], references: [id])
  name                String
  chapterNumber       Int
  description         String?
  expectedWorkingDays Int      @default(0)
  sequenceNumber      Int
  isActive            Boolean  @default(true)
  createdBy           String?
  createdByUser       User?    @relation("ChapterCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  syllabusPlanChapters SyllabusPlanChapter[]

  @@unique([schoolId, subjectId, classId, chapterNumber])
  @@index([schoolId, subjectId, classId])
  @@map("chapters")
}

model SyllabusPlan {
  id              String   @id @default(uuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  sessionYear     Int
  classId         String
  class           Class    @relation(fields: [classId], references: [id])
  sectionId       String
  section         Section  @relation(fields: [sectionId], references: [id])
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id])
  teacherId       String?
  teacher         Teacher? @relation(fields: [teacherId], references: [id])
  status          String   @default("DRAFT")
  remarks         String?
  approvalEnabled Boolean  @default(false)
  createdBy       String?
  createdByUser   User?    @relation("SyllabusPlanCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chapters SyllabusPlanChapter[]

  @@unique([schoolId, sessionYear, classId, sectionId, subjectId])
  @@index([schoolId, sessionYear])
  @@index([teacherId])
  @@map("syllabus_plans")
}

model SyllabusPlanChapter {
  id                   String       @id @default(uuid())
  syllabusPlanId       String
  syllabusPlan         SyllabusPlan @relation(fields: [syllabusPlanId], references: [id], onDelete: Cascade)
  chapterId            String
  chapter              Chapter      @relation(fields: [chapterId], references: [id])
  sequenceNumber       Int
  expectedWorkingDays  Int          @default(0)
  plannedStartDate     DateTime?    @db.Date
  plannedEndDate       DateTime?    @db.Date
  adminRemarks         String?
  actualStartDate      DateTime?    @db.Date
  actualEndDate        DateTime?    @db.Date
  actualWorkingDays    Int          @default(0)
  completionPercentage Float        @default(0)
  status               String       @default("NOT_STARTED")
  scheduleStatus       String?
  teacherRemarks       String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  progressHistory ChapterProgressHistory[]
  approvals       ProgressApproval[]

  @@unique([syllabusPlanId, chapterId])
  @@index([syllabusPlanId, sequenceNumber])
  @@map("syllabus_plan_chapters")
}

model ChapterProgressHistory {
  id                     String              @id @default(uuid())
  syllabusPlanChapterId  String
  syllabusPlanChapter    SyllabusPlanChapter @relation(fields: [syllabusPlanChapterId], references: [id], onDelete: Cascade)
  previousPercentage     Float
  newPercentage          Float
  progressDate           DateTime            @db.Date
  workingDaysAdded       Int                 @default(0)
  totalActualWorkingDays Int                 @default(0)
  remarks                String?
  updatedBy              String
  updatedByUser          User                @relation("ProgressHistoryUpdatedBy", fields: [updatedBy], references: [id])
  createdAt              DateTime            @default(now())

  @@index([syllabusPlanChapterId, progressDate])
  @@map("chapter_progress_history")
}

model ProgressApproval {
  id                    String              @id @default(uuid())
  syllabusPlanChapterId String
  syllabusPlanChapter   SyllabusPlanChapter @relation(fields: [syllabusPlanChapterId], references: [id], onDelete: Cascade)
  submittedPercentage   Float
  approvedPercentage    Float?
  status                String              @default("PENDING")
  rejectionRemarks      String?
  correctionRemarks     String?
  reviewedBy            String?
  reviewedByUser        User?               @relation("ProgressApprovalReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([syllabusPlanChapterId, status])
  @@map("progress_approvals")
}

// ── CrashReport — mobile app crash reports ──────────────────────
// Sent from the React Native native crash handler. Only SUPER_ADMIN
// can view these; any authenticated user's device can submit.
model CrashReport {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Device & app context
  appVersion     String?
  buildNumber    String?
  platform       Platform?
  osVersion      String?
  deviceModel    String?
  // Crash details
  errorMessage   String
  stackTrace     String?
  errorType      String?
  isFatal        Boolean  @default(true)
  // When the crash actually happened on the device (client clock).
  // May differ from createdAt if the report was queued offline.
  crashedAt      DateTime?
  // Extra context the client sends (screen name, route, custom data…)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([platform])
  @@map("crash_reports")
}

// ── AcademicSession — tracks each year's session ─────────────
// One row per school per year so that promotions, attendance, and
// fees can be scoped to a session.  The "current" session is the one
// whose isCurrent flag is true (exactly one per school — enforced
// at the app layer, not in a partial unique, because Prisma
// doesn't support filtered uniques).
model AcademicSession {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String   // e.g. "2025-26"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  promotionBatches PromotionBatch[]
  admissions       Admission[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@map("academic_sessions")
}

// ── PromotionBatch — one admin action that promotes N students ──
model PromotionBatch {
  id               String           @id @default(uuid())
  schoolId         String
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession  AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  fromClassId      String
  fromClass        Class            @relation("PromotionFromClass", fields: [fromClassId], references: [id], onDelete: Restrict)
  toClassId        String
  toClass          Class            @relation("PromotionToClass", fields: [toClassId], references: [id], onDelete: Restrict)
  promotedCount    Int
  status           String           @default("COMPLETED") // COMPLETED | ROLLED_BACK
  promotedBy       String
  promotedByUser   User             @relation("PromotionBatchBy", fields: [promotedBy], references: [id], onDelete: Restrict)
  rolledBackAt     DateTime?
  createdAt        DateTime         @default(now())

  records PromotionRecord[]

  @@index([schoolId, createdAt(sort: Desc)])
  @@map("promotion_batches")
}

// ── PromotionRecord — per-student snapshot of the move ──────────
// Stores the old class/section/rollNo so rollback can restore them.
model PromotionRecord {
  id              String         @id @default(uuid())
  batchId         String
  batch           PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  fromClassId     String
  fromSectionId   String
  fromRollNo      Int
  toClassId       String
  toSectionId     String
  toRollNo        Int

  @@unique([batchId, studentId])
  @@map("promotion_records")
}

// ── Admission — inquiry → application → approved → enrolled ────
enum AdmissionStatus {
  INQUIRY
  APPLIED
  APPROVED
  ENROLLED
  REJECTED
  WITHDRAWN
}

model Admission {
  id                String           @id @default(uuid())
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSessionId String?
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  // Application number — auto-generated, e.g. "APP0001"
  applicationNo     String
  // Student details (not linked to Student table until enrolled)
  studentName       String
  gender            Gender
  dateOfBirth       DateTime
  classId           String
  class             Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  // Parent details
  parentName        String
  parentPhone       String
  parentEmail       String
  // Additional info
  previousSchool    String?
  address           String?
  bloodGroup        String?
  // Workflow
  status            AdmissionStatus  @default(INQUIRY)
  remarks           String?
  // Set when status = ENROLLED
  enrolledStudentId String?
  // Tracking
  createdBy         String
  createdByUser     User             @relation("AdmissionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, createdAt(sort: Desc)])
  @@map("admissions")
}

// ── ParentQuery — parents ask school admin/principal directly ──
enum ParentQueryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ParentQuery {
  id            String            @id @default(uuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id])
  createdBy     String
  createdByUser User              @relation("ParentQueryCreatedBy", fields: [createdBy], references: [id])
  subject       String
  message       String
  status        ParentQueryStatus @default(OPEN)
  reply         String?
  repliedAt     DateTime?
  repliedBy     String?
  repliedByUser User?             @relation("ParentQueryRepliedBy", fields: [repliedBy], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([schoolId, createdBy, createdAt(sort: Desc)])
  @@index([schoolId, status, createdAt(sort: Desc)])
  @@map("parent_queries")
}
