{
  "name": "fieldbook-server",
  "version": "1.0.0",
  "description": "FieldBook Backend API — Node.js + Express + TypeScript + PostgreSQL + Prisma",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "TS_NODE_TRANSPILE_ONLY=true node --test --require ts-node/register tests/analytics.utils.test.ts tests/roleKey.test.ts tests/permissions.test.ts tests/fees.test.ts",
    "test:integration": "TS_NODE_TRANSPILE_ONLY=true node --test --test-concurrency=1 --require ts-node/register tests/analytics.integration.test.ts tests/customRoles.integration.test.ts tests/permissions.integration.test.ts tests/fees.integration.test.ts",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "create-super-admin": "ts-node scripts/create-super-admin.ts",
    "dev:live": "node scripts/with-env.js .env.live ts-node-dev --respawn --transpile-only src/server.ts",
    "studio:local": "prisma studio --port 5560",
    "studio:live": "node scripts/with-env.js .env.live prisma studio --port 5561",
    "migrate:live": "node scripts/with-env.js .env.live prisma migrate deploy",
    "migrate:status:live": "node scripts/with-env.js .env.live prisma migrate status",
    "create-super-admin:live": "node scripts/with-env.js .env.live ts-node scripts/create-super-admin.ts",
    "dev:demo": "node scripts/with-env.js .env.demo ts-node-dev --respawn --transpile-only src/server.ts",
    "studio:demo": "node scripts/with-env.js .env.demo prisma studio --port 5562",
    "migrate:demo": "node scripts/with-env.js .env.demo prisma migrate deploy",
    "migrate:status:demo": "node scripts/with-env.js .env.demo prisma migrate status",
    "create-super-admin:demo": "node scripts/with-env.js .env.demo ts-node scripts/create-super-admin.ts",
    "ping:live": "curl -s --max-time 90 https://zero5aa0834a03bba18f7cc427f42a8ba49.onrender.com/health && echo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "firebase-admin": "^14.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^9.0.3",
    "razorpay": "^2.9.8",
    "sanitize-html": "^2.18.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.2",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
