# ── Demo profile (demo database) ─────────────────────────────────
# Copy to .env.demo and fill in. Used by the *:demo npm scripts.
# Values here override .env; anything left out falls back to .env.
# If this is a Neon DB, use the DIRECT URL (no "-pooler") — migrations need it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
