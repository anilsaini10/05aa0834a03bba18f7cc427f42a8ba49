# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:123456@localhost:5432/fieldbook

# ── JWT ────────────────────────────────────────────────────────
# Must be at least 32 characters — use: openssl rand -base64 32
JWT_ACCESS_SECRET=Arise@2026
JWT_REFRESH_SECRET=Arise@2026
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Security ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── CORS ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Firebase (push notifications) ────────────────────────────────
# Path to the Firebase service account key JSON (download from
# Firebase Console → Project Settings → Service Accounts). Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Gmail SMTP (forgot-password OTP emails) ───────────────────────
# GMAIL_APP_PASSWORD is a 16-char App Password, NOT your normal Gmail
# password — needs 2-Step Verification enabled on the Google account:
# Google Account → Security → 2-Step Verification → App Passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
