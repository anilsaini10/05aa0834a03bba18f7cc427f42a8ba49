{
  "info": {
    "name": "Arise App API",
    "description": "Auth (signup/login/refresh/logout/me), School directory search, Push Notifications, Admin academic management (classes, subjects, students, teachers, announcements), and Teacher/Parent self-service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "schoolId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "deviceToken", "value": "sample-fcm-device-token-123", "type": "string" },
    { "key": "classId", "value": "", "type": "string" },
    { "key": "sectionId", "value": "", "type": "string" },
    { "key": "subjectId", "value": "", "type": "string" },
    { "key": "parentEmail", "value": "suresh.verma@example.com", "type": "string" },
    { "key": "teacherEmail", "value": "priya.singh@example.com", "type": "string" },
    { "key": "teacherId", "value": "", "type": "string" },
    { "key": "studentId", "value": "", "type": "string" },
    { "key": "announcementId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (ADMIN + creates School)",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.tokens.refreshToken);",
                  "  pm.collectionVariables.set('schoolId', body.data.user.schoolId);",
                  "  pm.collectionVariables.set('userId', body.data.user.id);",
                  "  pm.test('Signup succeeded', () => pm.expect(body.success).to.be.true);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schoolName\": \"Green Valley School\",\n  \"name\": \"Rita Sharma\",\n  \"email\": \"rita@greenvalley.com\",\n  \"phone\": \"9998887771\",\n  \"password\": \"pass1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            },
            "description": "Creates a new School and its ADMIN user in one transaction. Fails with 409 EMAIL_TAKEN if email already exists. Saves accessToken, refreshToken, schoolId, userId to collection variables."
          }
        },
        {
          "name": "Signup - Duplicate Email (expect 409)",
          "auth": { "type": "noauth" },
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schoolName\": \"Another School\",\n  \"name\": \"Someone Else\",\n  \"email\": \"rita@greenvalley.com\",\n  \"phone\": \"9998887772\",\n  \"password\": \"pass1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Login - ADMIN",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.tokens.refreshToken);",
                  "  pm.collectionVariables.set('schoolId', body.data.user.schoolId);",
                  "  pm.collectionVariables.set('userId', body.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"rita@greenvalley.com\",\n  \"password\": \"pass1234\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "identifier can be email or phone. schoolId is ignored/not required for ADMIN."
          }
        },
        {
          "name": "Login - TEACHER (school-scoped)",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.tokens.refreshToken);",
                  "  pm.collectionVariables.set('userId', body.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"teacher@example.com\",\n  \"password\": \"teacherpass1\",\n  \"role\": \"TEACHER\",\n  \"schoolId\": \"{{schoolId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "schoolId is REQUIRED for TEACHER/PARENT roles — get it from GET /api/schools. Returns 400 SCHOOL_ID_REQUIRED if missing, 401 INVALID_CREDENTIALS if identifier/role/schoolId don't match together."
          }
        },
        {
          "name": "Login - PARENT (school-scoped)",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.tokens.refreshToken);",
                  "  pm.collectionVariables.set('userId', body.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{parentEmail}}\",\n  \"password\": \"Suresh.verma@12345\",\n  \"role\": \"PARENT\",\n  \"schoolId\": \"{{schoolId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Same school-scoped rules as TEACHER login. Password here is the auto-generated default (capitalized email local-part + '@12345') returned once when the admin created this student's parent account."
          }
        },
        {
          "name": "Refresh Token",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Returns a new accessToken. Fails with 401 INVALID_REFRESH_TOKEN if expired/revoked."
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Requires Authorization: Bearer <accessToken> (inherited from collection auth). Returns the decoded JWT payload (sub, email, role, schoolId)."
          }
        },
        {
          "name": "Logout",
          "auth": { "type": "noauth" },
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Revokes the given refresh token."
          }
        }
      ]
    },
    {
      "name": "Schools",
      "item": [
        {
          "name": "List Schools (no filter)",
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schools",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schools"]
            },
            "description": "Public, no auth required. Returns up to 20 schools, sorted by name."
          }
        },
        {
          "name": "Search Schools",
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/schools?search=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schools"],
              "query": [{ "key": "search", "value": "delhi" }]
            },
            "description": "Case-insensitive partial match on school name. Public, no auth required."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Register Device Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{deviceToken}}\",\n  \"platform\": \"ANDROID\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "register"]
            },
            "description": "Requires Authorization header (inherited). platform is optional: ANDROID | IOS | WEB. Upserts the token for the logged-in user."
          }
        },
        {
          "name": "Unregister Device Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{deviceToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications/unregister",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "unregister"]
            },
            "description": "Requires Authorization header (inherited). Call on logout/app uninstall."
          }
        },
        {
          "name": "Send Notification (ADMIN only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"title\": \"Hello!\",\n  \"body\": \"This is a test push notification\",\n  \"data\": { \"screen\": \"home\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "send"]
            },
            "description": "Requires Authorization header (inherited) AND role=ADMIN (403 otherwise). Fails 503 FIREBASE_NOT_CONFIGURED if the server's Firebase service account key isn't set up."
          }
        }
      ]
    },
    {
      "name": "Classes",
      "item": [
        {
          "name": "Create Class (with sections)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('classId', body.data.id);",
                  "  if (body.data.sections[0]) pm.collectionVariables.set('sectionId', body.data.sections[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Class 5\",\n  \"numericLevel\": 5,\n  \"sections\": [\n    { \"name\": \"A\", \"capacity\": 40 },\n    { \"name\": \"B\", \"capacity\": 35 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            },
            "description": "Requires ADMIN. Creates a Class with its initial Sections in one transaction. Fails 409 CLASS_NAME_TAKEN if (schoolId, name) already exists, 409 SECTION_NAME_TAKEN if two sections in the request share a name. Saves classId/sectionId to collection variables."
          }
        },
        {
          "name": "Create Class - Duplicate Name (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Class 5\",\n  \"numericLevel\": 5,\n  \"sections\": [{ \"name\": \"C\", \"capacity\": 30 }]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "Add Section to Class",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"C\",\n  \"capacity\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}/sections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}", "sections"]
            },
            "description": "Requires ADMIN. Adds a new Section to an existing class. 404 CLASS_NOT_FOUND if classId doesn't belong to this school, 409 SECTION_NAME_TAKEN if the name is already used in this class."
          }
        },
        {
          "name": "Link Subject to Class",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjectId\": \"{{subjectId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}/subjects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}", "subjects"]
            },
            "description": "Requires ADMIN. Idempotent — links an existing Subject to this Class's curriculum (no error if already linked). 404 CLASS_NOT_FOUND / SUBJECT_NOT_FOUND otherwise."
          }
        },
        {
          "name": "List Classes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            },
            "description": "Requires ADMIN. Returns all classes for the admin's school — each with its sections (+ computed student counts) and the subjects taught in it (via ClassSubject)."
          }
        }
      ]
    },
    {
      "name": "Subjects",
      "item": [
        {
          "name": "Create Subject",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('subjectId', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science\",\n  \"classIds\": [\"{{classId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subjects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subjects"]
            },
            "description": "Requires ADMIN. classIds is optional — if given, immediately links the new subject to those classes (404 CLASS_NOT_FOUND if any don't belong to this school). Fails 409 SUBJECT_ALREADY_EXISTS if (schoolId, name) already exists. Saves subjectId to collection variables."
          }
        },
        {
          "name": "Create Subject - Duplicate Name (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subjects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subjects"]
            }
          }
        },
        {
          "name": "List Subjects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/subjects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subjects"]
            },
            "description": "Requires ADMIN. Returns all subjects for the admin's school, each with the classes it's taught in. Subjects are also created implicitly the first time a teacher is added with a new subject name."
          }
        }
      ]
    },
    {
      "name": "Admin - Students",
      "item": [
        {
          "name": "Create Student (new parent account)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Verma\",\n  \"gender\": \"MALE\",\n  \"dateOfBirth\": \"2015-04-10\",\n  \"classId\": \"{{classId}}\",\n  \"sectionId\": \"{{sectionId}}\",\n  \"rollNo\": 1,\n  \"parentName\": \"Suresh Verma\",\n  \"parentPhone\": \"9812345670\",\n  \"parentEmail\": \"{{parentEmail}}\",\n  \"bloodGroup\": \"O+\",\n  \"address\": \"123 MG Road\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "students"]
            },
            "description": "Requires ADMIN. classId/sectionId must belong to this school (404 CLASS_NOT_FOUND / SECTION_NOT_FOUND otherwise). If parentEmail is new, creates a PARENT user and returns a one-time plaintext defaultPassword — capitalized local-part of the email + '@12345'."
          }
        },
        {
          "name": "Create Student (sibling — reuses parent account)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Diya Verma\",\n  \"gender\": \"FEMALE\",\n  \"dateOfBirth\": \"2017-08-22\",\n  \"classId\": \"{{classId}}\",\n  \"sectionId\": \"{{sectionId}}\",\n  \"rollNo\": 2,\n  \"parentName\": \"Suresh Verma\",\n  \"parentPhone\": \"9812345670\",\n  \"parentEmail\": \"{{parentEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "students"]
            },
            "description": "Same parentEmail as the previous request — the existing PARENT user is reused. Response's parentAccount.isNew will be false and defaultPassword will be omitted."
          }
        },
        {
          "name": "Create Student - Invalid Class (expect 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"gender\": \"MALE\",\n  \"dateOfBirth\": \"2015-04-10\",\n  \"classId\": \"00000000-0000-0000-0000-000000000000\",\n  \"sectionId\": \"{{sectionId}}\",\n  \"rollNo\": 99,\n  \"parentName\": \"Nobody\",\n  \"parentPhone\": \"9000000000\",\n  \"parentEmail\": \"nobody@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "students"]
            },
            "description": "classId doesn't exist / doesn't belong to this school -> 404 CLASS_NOT_FOUND."
          }
        },
        {
          "name": "List Students",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data.items[0]) pm.collectionVariables.set('studentId', body.data.items[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/students?page=1&pageSize=15&search=verma",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "students"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "15" },
                { "key": "search", "value": "verma" },
                { "key": "classId", "value": "{{classId}}", "disabled": true },
                { "key": "sectionId", "value": "{{sectionId}}", "disabled": true }
              ]
            },
            "description": "Requires ADMIN. search matches name/admissionNo/parentName. Enable the classId/sectionId query params to filter further. Saves the first result's id to {{studentId}} for use in Get Student Details below."
          }
        },
        {
          "name": "Get Student Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/students/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "students", "{{studentId}}"]
            },
            "description": "Requires ADMIN. Fetches a single student's full details by id (same shape as one item from List Students). 404 STUDENT_NOT_FOUND if the id doesn't exist or belongs to a different school."
          }
        }
      ]
    },
    {
      "name": "Admin - Teachers",
      "item": [
        {
          "name": "Create Teacher",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Singh\",\n  \"email\": \"{{teacherEmail}}\",\n  \"phone\": \"9123456780\",\n  \"gender\": \"FEMALE\",\n  \"subject\": \"Mathematics\",\n  \"classId\": \"{{classId}}\",\n  \"salary\": 45000,\n  \"joiningDate\": \"2024-06-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "teachers"]
            },
            "description": "Requires ADMIN. classId says which class this teacher teaches `subject` in — 404 CLASS_NOT_FOUND if it doesn't belong to this school. Creates a TEACHER user (password = generateDefaultPassword(email), returned once as plaintext defaultPassword), a Teacher profile, upserts the Subject by (schoolId, name), links it into the class's curriculum (ClassSubject) if not already, and records the teacher-subject-class assignment. Fails 409 EMAIL_TAKEN if the email belongs to any user at this school.\n\nOptional field `classTeacherSectionId` (see 'Create Teacher as Class Teacher' below) makes this teacher the homeroom/Class Teacher of a section — independent of the subject/classId above."
          }
        },
        {
          "name": "Create Teacher as Class Teacher (classTeacherSectionId)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rekha Gupta\",\n  \"email\": \"rekha.gupta@example.com\",\n  \"phone\": \"9123456790\",\n  \"gender\": \"FEMALE\",\n  \"subject\": \"Hindi\",\n  \"classId\": \"{{classId}}\",\n  \"salary\": 42000,\n  \"joiningDate\": \"2024-06-01\",\n  \"classTeacherSectionId\": \"{{sectionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "teachers"]
            },
            "description": "Requires ADMIN. `classTeacherSectionId` is OPTIONAL — when provided, this teacher becomes the Class Teacher (homeroom in-charge) of that section (sets Section.classTeacherId). It is independent of `classId`/`subject` above — a teacher can be Class Teacher of one section while teaching subjects in entirely different classes.\n\nErrors: 404 SECTION_NOT_FOUND if the section doesn't exist / belongs to another school. 409 SECTION_ALREADY_HAS_CLASS_TEACHER if that section already has a different class teacher assigned — reassignment isn't silent, you'd need to null it out first (no endpoint for that yet).\n\nThe response's `teacher.classTeacherOf` array reflects this (empty array if not a class teacher of anything). This also immediately shows up in GET /api/classes and GET /api/teacher/classes as that section's classTeacherId/classTeacherName."
          }
        },
        {
          "name": "Create Teacher - Duplicate Email (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Another Teacher\",\n  \"email\": \"{{teacherEmail}}\",\n  \"phone\": \"9123456781\",\n  \"gender\": \"MALE\",\n  \"subject\": \"Science\",\n  \"classId\": \"{{classId}}\",\n  \"salary\": 40000,\n  \"joiningDate\": \"2024-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "teachers"]
            }
          }
        },
        {
          "name": "Create Teacher - Invalid Class (expect 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Teacher\",\n  \"email\": \"bad.teacher@example.com\",\n  \"phone\": \"9123456799\",\n  \"gender\": \"MALE\",\n  \"subject\": \"Art\",\n  \"classId\": \"00000000-0000-0000-0000-000000000000\",\n  \"salary\": 30000,\n  \"joiningDate\": \"2024-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "teachers"]
            }
          }
        },
        {
          "name": "List Teachers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data.items[0]) pm.collectionVariables.set('teacherId', body.data.items[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/teachers?page=1&pageSize=15&subject=Mathematics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "teachers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "15" },
                { "key": "subject", "value": "Mathematics" },
                { "key": "classId", "value": "{{classId}}", "disabled": true },
                { "key": "search", "value": "priya", "disabled": true }
              ]
            },
            "description": "Requires ADMIN. search matches name/employeeId/email. subject filters by exact subject name, classId filters to teachers assigned to that class. Saves the first result's id to {{teacherId}} for use in Get Teacher Details below."
          }
        },
        {
          "name": "Get Teacher Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/teachers/{{teacherId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "teachers", "{{teacherId}}"]
            },
            "description": "Requires ADMIN. Fetches a single teacher's full details by id (same shape as one item from List Teachers). 404 TEACHER_NOT_FOUND if the id doesn't exist or belongs to a different school."
          }
        }
      ]
    },
    {
      "name": "Admin - Announcements",
      "item": [
        {
          "name": "Create Announcement (audience=ALL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('announcementId', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"School reopens Monday\",\n  \"message\": \"School reopens on Monday after the break.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/announcements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "announcements"]
            },
            "description": "Requires ADMIN. `audience` defaults to ALL if omitted — valid values: ALL | TEACHER | PARENT. eventDate/publishAt/expiresAt are all optional (see 'Create Scheduled Announcement' below). Saves the created id to {{announcementId}}."
          }
        },
        {
          "name": "Create Scheduled Announcement (publishAt/expiresAt/eventDate)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Annual Sports Day\",\n  \"message\": \"Sports day will be held on the school ground.\",\n  \"audience\": \"ALL\",\n  \"eventDate\": \"2026-12-25\",\n  \"publishAt\": \"2026-12-01T00:00:00Z\",\n  \"expiresAt\": \"2026-12-26T00:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/announcements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "announcements"]
            },
            "description": "All three date fields are optional and independent:\n- eventDate: the date this announcement is ABOUT (display only, doesn't affect visibility).\n- publishAt: don't show this to teachers/parents until this date/time (null = visible immediately).\n- expiresAt: stop showing this after this date/time (null = never expires).\nAdmin's own list/get always shows it regardless of the window — only the Teacher/Parent self-service feeds (GET /api/teacher/announcements, GET /api/students/announcements) filter by publishAt/expiresAt. The response's computed `status` field (SCHEDULED/ACTIVE/EXPIRED) tells you which state it's currently in. 400 VALIDATION_ERROR if expiresAt <= publishAt."
          }
        },
        {
          "name": "Create Announcement (audience=TEACHER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Staff meeting Friday\",\n  \"message\": \"All teachers meeting at 3pm Friday.\",\n  \"audience\": \"TEACHER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/announcements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "announcements"]
            }
          }
        },
        {
          "name": "Create Announcement (audience=PARENT)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fee due reminder\",\n  \"message\": \"Term fee due by 15th.\",\n  \"audience\": \"PARENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/announcements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "announcements"]
            }
          }
        },
        {
          "name": "Create Announcement - Invalid Audience (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bad\",\n  \"message\": \"x\",\n  \"audience\": \"EVERYONE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/announcements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "announcements"]
            }
          }
        },
        {
          "name": "List Announcements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/announcements?page=1&pageSize=15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "announcements"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "15" },
                { "key": "search", "value": "fee", "disabled": true },
                { "key": "audience", "value": "TEACHER", "disabled": true }
              ]
            },
            "description": "Requires ADMIN. search matches title/message. audience filters by exact ALL|TEACHER|PARENT value."
          }
        },
        {
          "name": "Get Announcement Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/announcements/{{announcementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "announcements", "{{announcementId}}"]
            },
            "description": "Requires ADMIN. 404 ANNOUNCEMENT_NOT_FOUND if the id doesn't exist or belongs to a different school."
          }
        },
        {
          "name": "Update Announcement",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"School reopens Tuesday now\",\n  \"audience\": \"PARENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/announcements/{{announcementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "announcements", "{{announcementId}}"]
            },
            "description": "Requires ADMIN. Partial update — send only the field(s) you want to change (title/message/audience/eventDate/publishAt/expiresAt). At least one is required, 400 VALIDATION_ERROR if body is empty. If you change only one of publishAt/expiresAt, it's cross-checked against the OTHER field's existing stored value — 400 INVALID_DATE_RANGE if the merged result would have expiresAt <= publishAt."
          }
        },
        {
          "name": "Delete Announcement",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/admin/announcements/{{announcementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "announcements", "{{announcementId}}"]
            },
            "description": "Requires ADMIN. Hard delete — cannot be undone. 404 ANNOUNCEMENT_NOT_FOUND if already deleted or belongs to a different school."
          }
        }
      ]
    },
    {
      "name": "Teacher (Self-Service)",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/teacher/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "profile"]
            },
            "description": "Requires TEACHER role (log in via Auth > Login - TEACHER first). Returns this teacher's own profile, including every subject+class they're assigned to."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9999999999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/teacher/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "profile"]
            },
            "description": "Requires TEACHER. Only name/phone are self-editable — at least one must be present. Email/subjects/salary/status are admin-managed only."
          }
        },
        {
          "name": "Reset My Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Priya.singh@12345\",\n  \"newPassword\": \"NewPass@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/teacher/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "reset-password"]
            },
            "description": "Requires TEACHER. 400 INVALID_CURRENT_PASSWORD if currentPassword is wrong. On success, ALL of this user's refresh tokens are revoked (including {{refreshToken}} above) — you must log in again afterward to get a fresh session. Use this to change the one-time defaultPassword the admin generated."
          }
        },
        {
          "name": "List My Classes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/teacher/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "classes"]
            },
            "description": "Requires TEACHER. Returns ONLY the classes this teacher is actually assigned to (via TeacherSubject) — never the whole school's class list like the admin endpoint. Each class's `mySubjects` shows only this teacher's own subjects in it (not the full curriculum)."
          }
        },
        {
          "name": "List My Students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/teacher/students?classId={{classId}}&page=1&pageSize=15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "students"],
              "query": [
                { "key": "classId", "value": "{{classId}}" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "15" },
                { "key": "sectionId", "value": "{{sectionId}}", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            },
            "description": "Requires TEACHER. classId is REQUIRED and must be one of this teacher's own classes (from List My Classes) — otherwise 403 CLASS_NOT_ASSIGNED. Never trust a client-supplied classId for a class this teacher doesn't actually teach."
          }
        },
        {
          "name": "List My Announcements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/teacher/announcements?page=1&pageSize=15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teacher", "announcements"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "15" },
                { "key": "search", "value": "", "disabled": true }
              ]
            },
            "description": "Requires TEACHER. Returns only announcements with audience=ALL or audience=TEACHER for this teacher's school — PARENT-only announcements are never included. Also excludes anything not yet published (publishAt in the future) or already expired (expiresAt in the past) — you only ever see currently-active ones here."
          }
        }
      ]
    },
    {
      "name": "Student/Parent (Self-Service)",
      "item": [
        {
          "name": "Get My Profile (+ my children)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "profile"]
            },
            "description": "Requires PARENT role (log in via Auth > Login - PARENT first). Returns the parent's own profile plus every child (Student) linked to them — a parent can have multiple children."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9812345670\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "profile"]
            },
            "description": "Requires PARENT. Only the parent's own name/phone are self-editable — at least one must be present. The child's student record (class, roll no, attendance...) is admin/teacher-managed, not editable here."
          }
        },
        {
          "name": "Reset My Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Suresh.verma@12345\",\n  \"newPassword\": \"NewPass@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "reset-password"]
            },
            "description": "Requires PARENT. 400 INVALID_CURRENT_PASSWORD if currentPassword is wrong. On success, ALL of this user's refresh tokens are revoked — log in again afterward. Use this to change the one-time defaultPassword the admin generated when this student was added."
          }
        },
        {
          "name": "List My Announcements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students/announcements?page=1&pageSize=15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "announcements"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "15" },
                { "key": "search", "value": "", "disabled": true }
              ]
            },
            "description": "Requires PARENT. Returns only announcements with audience=ALL or audience=PARENT for this parent's school — TEACHER-only announcements are never included. Also excludes anything not yet published (publishAt in the future) or already expired (expiresAt in the past) — you only ever see currently-active ones here."
          }
        }
      ]
    }
  ]
}
